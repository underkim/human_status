# Copy this file to android/key.properties and fill in your own values for
# a LOCAL Android release build (`flutter build apk --release` /
# `flutter build appbundle --release`).
#
# android/key.properties is already listed in .gitignore -- NEVER commit it,
# and NEVER put a real password/alias/path into this .example file. This
# file must only ever contain obvious placeholders.
#
# In CI, do not use this file at all -- set the equivalent environment
# variables instead (see docs/RELEASE_CHECKLIST.md):
#   ANDROID_KEYSTORE_PATH, ANDROID_STORE_PASSWORD, ANDROID_KEY_ALIAS,
#   ANDROID_KEY_PASSWORD
# A non-empty CI environment variable always overrides the matching value
# below.
#
# storeFile may be an absolute path (Windows paths like
# C:\keys\release.jks are fine) or a path relative to this android/
# directory.

storeFile=REPLACE_WITH_PATH_TO_YOUR_RELEASE_KEYSTORE.jks
storePassword=REPLACE_WITH_YOUR_KEYSTORE_PASSWORD
keyAlias=REPLACE_WITH_YOUR_KEY_ALIAS
keyPassword=REPLACE_WITH_YOUR_KEY_PASSWORD
